{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier",
  "version": "0.1.0",
  "identifier": "dev.atelier.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bridge && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atelier",
        "label": "main",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.mzstatic.com; media-src 'self' https://audio-ssl.itunes.apple.com https://*.mzstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "resources": {
      "../bridge/main.mjs": "bridge/main.mjs",
      "../bridge/package.json": "bridge/package.json",
      "../bridge/node_modules/": "bridge/node_modules/"
    },
    "linux": {
      "deb": {
        "depends": ["nodejs"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
